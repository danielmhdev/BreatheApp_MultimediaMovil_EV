<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f3fbf4">

    <!-- Fondo -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.50"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo_bosque_background" />

    <!-- Botón volver -->
    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Volver"
        android:elevation="4dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_back" />

    <!-- Contenido -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <!-- Título de la pantalla -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Control de Ansiedad"
            android:textColor="#4a654f"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Subtítulo: fase activa del ejercicio (INHALAR / MANTENER / EXHALAR) -->
        <TextView
            android:id="@+id/txt_fase_actual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            android:letterSpacing="0.2"
            android:text=""
            android:textColor="#4a654f"
            android:textSize="13sp" />

        <!-- Círculo animado que representa el ritmo de respiración -->
        <View
            android:id="@+id/view_circulo_respiracion"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginBottom="40dp"
            android:alpha="0.5"
            android:background="@drawable/circulo_respiracion"
            android:scaleX="0.6"
            android:scaleY="0.6" />

        <!-- Texto guía -->
        <TextView
            android:id="@+id/txt_guia_respiracion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Pulsa Empezar"
            android:textColor="#4a654f"
            android:textSize="28sp"
            android:textStyle="bold"
            android:visibility="invisible" />

        <!-- Número de ciclos completados en la sesión actual -->
        <TextView
            android:id="@+id/txt_ciclos_completados"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="48dp"
            android:text="Ciclos: 0"
            android:textColor="#4a654f"
            android:textSize="16sp" />

        <!-- Botón para iniciar o detener el ejercicio -->
        <Button
            android:id="@+id/btn_empezar_respiracion"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:backgroundTint="#8daa91"
            android:text="Empezar Ejercicio"
            android:textColor="#ffffff"
            android:textSize="18sp"
            app:cornerRadius="12dp" />

    </LinearLayout>
</FrameLayout>