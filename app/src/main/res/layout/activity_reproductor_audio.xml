<!-- Añadimos xmlns:app para poder usar cornerRadius en los botones -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f3fbf4">

    <!-- Fondo -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.50"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo_bosque_background" />

    <!-- Botón volver -->
    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Volver"
        android:elevation="4dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_back" />

    <!-- Reproductor -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Imagen de portada del audio -->
        <ImageView
            android:id="@+id/img_portada_reproductor_audio"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_marginBottom="24dp"
            android:scaleType="centerCrop" />

        <!-- Título del audio en reproducción -->
        <TextView
            android:id="@+id/txt_titulo_reproductor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:textColor="#4a654f"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Barra de progreso coloreada a juego con los botones -->
        <SeekBar
            android:id="@+id/seek_bar_audio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:progressTint="#8daa91"
            android:thumbTint="#4a654f" />

        <!-- Textos de tiempo: izquierda actual, derecha total -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txt_tiempo_actual_audio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="00:00"
                android:textColor="#161d19"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txt_tiempo_total_audio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#161d19"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Controles de reproducción: retroceder, play/pause, adelantar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_retroceder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#8daa91"
                android:text="⏪️"
                android:textColor="#ffffff"
                android:textSize="18sp"
                app:cornerRadius="12dp" />

            <Button
                android:id="@+id/btn_play_pause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#8daa91"
                android:text="⏯️"
                android:textColor="#ffffff"
                android:textSize="18sp"
                app:cornerRadius="12dp" />

            <Button
                android:id="@+id/btn_adelantar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#8daa91"
                android:text="⏩️"
                android:textColor="#ffffff"
                android:textSize="18sp"
                app:cornerRadius="12dp" />

        </LinearLayout>
    </LinearLayout>
</FrameLayout>